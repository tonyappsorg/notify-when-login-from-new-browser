        <mj-text font-size="12px" font-weight="600" letter-spacing="1px" color="#e22626" padding-bottom="0">{{trans "Security alert"}}</mj-text>
        <mj-text font-size="24px" font-weight="600">{{trans "New sign-in to your admin account"}}</mj-text>
        <mj-text>{{trans "Hi %name, your admin account was just used to sign in from a device we haven't seen before." name=$firstname}}</mj-text>
        <mj-raw ta-block="notifyonnewbrowserlogin_details"></mj-raw>
        <mj-text><strong>{{trans "Was this you?"}}</strong> {{trans "Then there's nothing to do. We remember this device, so you won't hear from us again when you sign in from it."}}</mj-text>
        <mj-text><table width="100%" cellpadding="0" cellspacing="0" role="presentation"><tr><td style="padding:16px 20px;background:#fdf0f0;border-left:4px solid #e22626;border-radius:2px;"><p style="margin:0 0 8px;font-size:16px;font-weight:600;">{{trans "Wasn't you?"}}</p><p style="margin:0 0 4px;">{{trans "1. Change your password straight away."}}</p><p style="margin:0 0 4px;">{{trans "2. Ask another administrator to check your account and recent admin activity."}}</p><p style="margin:0;">{{trans "3. If your store has Action Log, end your other sessions under Action Log › Active Sessions."}}</p></td></tr></table></mj-text>
        <mj-button background-color="#e22626" border-radius="3px" font-size="16px" font-weight="600" inner-padding="14px 32px" href="{{var accountUrl}}">{{trans "Change your password"}}</mj-button>
        <mj-divider border-width="1px" border-color="#e5e5e5"></mj-divider>
        <mj-text font-size="12px" color="#999999">{{trans "We send this the first time your account signs in from a browser or an API client. Clearing cookies or using a private window counts as a new device."}}</mj-text>
