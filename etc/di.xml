<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Tonyapps_EmailDesigner: a block and a starter design for the sign-in alert. Ignored without that module. -->
    <type name="Tonyapps\EmailDesigner\Model\BlockPool">
        <arguments>
            <argument name="blocks" xsi:type="array">
                <item name="notifyonnewbrowserlogin_details" xsi:type="array">
                    <item name="label" xsi:type="string" translate="true">Sign-in details</item>
                    <item name="templates" xsi:type="array">
                        <item name="0" xsi:type="string">admin_security_new_browser_login_template</item>
                    </item>
                    <item name="directive" xsi:type="string"><![CDATA[<table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="background:#f8f8f8;border:1px solid #e5e5e5;border-radius:4px;"><tr><td style="padding:12px 16px;border-bottom:1px solid #e5e5e5;color:#666666;width:40%;">{{trans "Account"}}</td><td style="padding:12px 16px;border-bottom:1px solid #e5e5e5;font-weight:600;">{{var username}}</td></tr><tr><td style="padding:12px 16px;border-bottom:1px solid #e5e5e5;color:#666666;">{{trans "Signed in through"}}</td><td style="padding:12px 16px;border-bottom:1px solid #e5e5e5;font-weight:600;">{{var channel}}</td></tr><tr><td style="padding:12px 16px;border-bottom:1px solid #e5e5e5;color:#666666;">{{trans "Device"}}</td><td style="padding:12px 16px;border-bottom:1px solid #e5e5e5;font-weight:600;">{{trans "%browser on %platform" browser=$browser platform=$platform}}</td></tr><tr><td style="padding:12px 16px;border-bottom:1px solid #e5e5e5;color:#666666;">{{trans "IP address"}}</td><td style="padding:12px 16px;border-bottom:1px solid #e5e5e5;font-weight:600;">{{var ip}}</td></tr><tr><td style="padding:12px 16px;color:#666666;">{{trans "Time"}}</td><td style="padding:12px 16px;font-weight:600;">{{var time}}</td></tr></table>]]></item>
                </item>
            </argument>
            <argument name="starters" xsi:type="array">
                <item name="admin_security_new_browser_login_template" xsi:type="string">Tonyapps_NotifyOnNewBrowserLogin::view/adminhtml/email_designer/new_browser_login_notification.mjml</item>
            </argument>
        </arguments>
    </type>
</config>
